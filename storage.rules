rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@sowmyaselections.com';
    }
    
    // Products images - public read access, admin write access
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Other storage - authenticated users only
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}